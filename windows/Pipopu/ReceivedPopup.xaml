<local:FlyoutWindow x:Class="Pipopu.ReceivedPopup" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Pipopu"
    Title="Pipopu · Received" Width="414" Height="342" Topmost="True" ShowInTaskbar="False"
    FontFamily="{DynamicResource BodyFont}" FontSize="14"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}">
  <Grid Margin="24,14,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <DockPanel LastChildFill="True">
      <Button DockPanel.Dock="Right" Style="{DynamicResource CloseButton}" Click="CloseClick" />
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Image Source="{DynamicResource AppIcon}" Width="18" Height="18" Margin="0,0,8,0" />
        <TextBlock Text="Pipopu" FontWeight="SemiBold" />
      </StackPanel>
    </DockPanel>
    <TextBlock x:Name="HeadingText" Grid.Row="1" Style="{DynamicResource Heading}" Margin="0,12,0,0" />
    <Grid Grid.Row="2" Margin="0,12,0,14">
      <TextBox x:Name="Details" IsReadOnly="True" IsTabStop="False" Background="Transparent"
               TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="0,3"
               BorderThickness="0" FontSize="16" AutomationProperties.Name="Received content">
        <TextBox.Template>
          <ControlTemplate TargetType="TextBox">
            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" Focusable="False" />
          </ControlTemplate>
        </TextBox.Template>
      </TextBox>
      <Image x:Name="Preview" Stretch="Uniform" HorizontalAlignment="Left" Visibility="Collapsed"
             AutomationProperties.Name="Received image" />
    </Grid>
    <DockPanel Grid.Row="3" LastChildFill="True">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button x:Name="CopyButton" Style="{DynamicResource AccentButtonStyle}" MinHeight="36"
                Padding="15,5" Click="CopyClick">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE8C8;" FontFamily="{DynamicResource SymbolFont}" Margin="0,0,7,0" />
            <TextBlock x:Name="CopyText" />
          </StackPanel>
        </Button>
        <Button x:Name="SaveButton" Style="{DynamicResource AccentButtonStyle}" MinHeight="36"
                Padding="15,5" AutomationProperties.Name="Save as…" Click="SaveClick">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE74E;" FontFamily="{DynamicResource SymbolFont}" Margin="0,0,7,0" />
            <TextBlock Text="Save as…" />
          </StackPanel>
        </Button>
      </StackPanel>
      <TextBlock x:Name="Status" Style="{DynamicResource SecondaryText}" TextWrapping="Wrap"
                 AutomationProperties.LiveSetting="Polite" Margin="0,0,12,0" VerticalAlignment="Center" />
    </DockPanel>
  </Grid>
</local:FlyoutWindow>
