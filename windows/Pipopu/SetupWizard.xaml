<Window x:Class="Pipopu.SetupWizard" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Welcome to Pipopu" Width="510" SizeToContent="Height" ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen" Icon="{DynamicResource AppIcon}"
    FontFamily="{DynamicResource BodyFont}" FontSize="14">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Padding="26,22">
      <Border.Background>
        <RadialGradientBrush Center="0.1,0" GradientOrigin="0.1,0" RadiusX="0.94" RadiusY="1.15">
          <GradientStop Color="#5540AA" Offset="0" />
          <GradientStop Color="#242044" Offset="0.65" />
          <GradientStop Color="#1C203A" Offset="1" />
        </RadialGradientBrush>
      </Border.Background>
      <StackPanel>
        <DockPanel LastChildFill="False">
          <Image Source="{DynamicResource AppIcon}" Width="31" Height="31" DockPanel.Dock="Left" />
          <TextBlock x:Name="StepText" Foreground="#E7E1FF" DockPanel.Dock="Right"
                     VerticalAlignment="Center" FontSize="13" AutomationProperties.LiveSetting="Polite" />
        </DockPanel>
        <TextBlock x:Name="HeadingText" Foreground="White" Style="{DynamicResource Heading}"
                   TextWrapping="Wrap" Margin="0,15,0,0" AutomationProperties.HeadingLevel="Level1" />
      </StackPanel>
    </Border>
    <StackPanel Grid.Row="1" Margin="26,20,26,14" MinHeight="134">
      <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" />
      <CheckBox x:Name="CloudChoice" Content="Open OneDrive settings when I finish" Margin="0,14,0,0" />
      <StackPanel x:Name="DesktopChoices" Margin="0,12,0,0">
        <CheckBox x:Name="MoveChoice" Content="Move Pipopu to Local AppData" />
        <TextBlock x:Name="MoveDetail" Style="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="25,3,0,10" />
        <CheckBox x:Name="StartupChoice" Content="Start Pipopu when I sign in to Windows" />
        <TextBlock Style="{DynamicResource SecondaryText}" Text="Starts quietly in the tray." Margin="25,3,0,0" />
      </StackPanel>
      <TextBlock x:Name="ProblemText" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"
                 AutomationProperties.LiveSetting="Assertive" />
    </StackPanel>
    <DockPanel Grid.Row="2" Margin="26,2,26,22" LastChildFill="False">
      <Button x:Name="SkipButton" Content="Skip setup" Click="SkipClick" Style="{DynamicResource QuietButton}"
              DockPanel.Dock="Left" />
      <Button x:Name="NextButton" Content="Continue" Click="NextClick" IsDefault="True"
              DockPanel.Dock="Right" MinWidth="110" MinHeight="36" Style="{DynamicResource AccentButtonStyle}" />
      <Button x:Name="BackButton" Content="Back" Click="BackClick" DockPanel.Dock="Right"
              MinWidth="65" Margin="0,0,8,0" Style="{DynamicResource QuietButton}" />
    </DockPanel>
  </Grid>
</Window>
