<local:FlyoutWindow x:Class="Pipopu.IncomingPopup" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Pipopu"
    Title="Pipopu · Incoming file" Width="414" Height="192" Topmost="True"
    ShowInTaskbar="False" ShowActivated="False"
    FontFamily="{DynamicResource BodyFont}" FontSize="14"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}">
  <StackPanel Margin="24,14,24,18">
    <DockPanel LastChildFill="True">
      <Button DockPanel.Dock="Right" Style="{DynamicResource CloseButton}" Click="CloseClick" />
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Image Source="{DynamicResource AppIcon}" Width="18" Height="18" Margin="0,0,8,0" />
        <TextBlock Text="Pipopu" FontWeight="SemiBold" />
      </StackPanel>
    </DockPanel>
    <TextBlock x:Name="FileName" Margin="0,10,0,0" Style="{DynamicResource Heading}"
               TextTrimming="CharacterEllipsis" />
    <TextBlock x:Name="Stage" Margin="0,5,0,0" Style="{DynamicResource SecondaryText}"
               TextWrapping="Wrap" MaxHeight="48" AutomationProperties.LiveSetting="Polite" />
    <ProgressBar x:Name="Bar" Height="5" Margin="0,13,0,0" Maximum="100"
                 AutomationProperties.Name="Incoming file progress" />
    <TextBlock x:Name="Details" Margin="0,7,0,0" Style="{DynamicResource SecondaryText}" />
  </StackPanel>
</local:FlyoutWindow>
